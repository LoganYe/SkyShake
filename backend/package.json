{
  "name": "skyshake-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run check:airports && tsc -p tsconfig.json",
    "check:airports": "node ../tool/generate-airport-catalog.mjs --check",
    "generate:airports": "node ../tool/generate-airport-catalog.mjs",
    "start": "node dist/server.js",
    "test": "npm run check:airports && vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "ioredis": "5.11.1",
    "node-app-attest": "1.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
